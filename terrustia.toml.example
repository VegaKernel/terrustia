# Copy to terrustia.toml to override the defaults. Every key is optional.
#
# No file at all is also a valid way to configure this: every key below has a
# TERRUSTIA_<UPPERCASE_KEY> environment variable equivalent (TERRUSTIA_LISTEN,
# TERRUSTIA_MAX_PLAYERS, TERRUSTIA_WORLD_NAME, ...) for Docker/automation use, where there is
# often no shell around the process to pass a --flag and no volume mount to put a file on.
# Precedence is defaults < this file < environment < an explicit CLI flag.

listen = "0.0.0.0:7777"
max_players = 8
motd = "Welcome to Terrustia"

# Leave empty for an open server. Clients are prompted before they get a player slot.
password = ""

# Serve an existing save instead of generating a world. When set, the world_* keys below are
# ignored because the file carries its own dimensions.
#
# Only a world loaded from a file can be saved. A generated world is playable but ephemeral.
# world_file = "/path/to/World.wld"

# Where saves go. Defaults to world_file; set it to leave the original untouched.
# save_file = "/path/to/Saved.wld"

# Seconds between automatic saves, or 0 to disable them. The disk write happens off the game task;
# what the tick pays is a copy of the tile array, about 30 ms on a full-size world.
autosave_secs = 300

# Both must be a whole number of 200x150 sections: the client sizes its own grid with
# `maxTilesX / 200`, truncating, so a ragged edge is world it can never ask for.
world_name = "Terrustia"
world_width = 4200
world_height = 1200
seed = 0

# Longest chat line accepted from a client, in bytes.
max_chat_len = 500

# Drop a connection that sends nothing at all for this long. A playing client sends control
# updates continuously, so this only catches dead sockets and stalled handshakes.
idle_timeout_secs = 60

# How many sockets may be open at once before anyone has said who they are, and how many of those
# one address may hold open at a time. Separate from max_players: a socket is accepted, and counts
# against these, well before it has a player slot.
max_connections = 512
max_connections_per_address = 8

# How long a connection has to finish the handshake before it is dropped. idle_timeout_secs above
# resets on any byte, so this is the backstop that makes a slowly-trickling connection's slot
# finite.
handshake_timeout_secs = 30

# The web admin panel. Off by default. `panel_listen` must be loopback (127.0.0.1 or ::1) — the
# server refuses to start otherwise. Remote panel access needs a deliberate step (an SSH tunnel,
# for example), not an accident of opening this up. Sign in with the same accounts `/register`
# creates.
panel_enabled = false
panel_listen = "127.0.0.1:7778"

# Check GitHub for a newer, signature-verified release on boot, and say so — console log, plus an
# in-game notice to the first recognised admin who signs in afterward. Applying it is always a
# separate, manual `terrustia update`; this only checks and notifies. Turn off for an air-gapped
# host, or to stop this server from talking to GitHub at all.
update_check_enabled = true

# Attempt UPnP automatic port-mapping for `listen` on startup. On by default; entirely background
# and non-fatal — when no UPnP-capable router answers, or it refuses, this logs a specific fallback
# message and moves on. Has nothing to do with the panel, which stays loopback-only regardless.
upnp_enabled = true
