[Unit]
Description=terrustia, a Terraria server
Documentation=https://github.com/bybrooklyn/terrustia
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terrustia
Group=terrustia
WorkingDirectory=/var/lib/terrustia
# Only difference from the top-level `packaging/terrustia.service` this is forked from: /usr/bin,
# not /usr/local/bin. This PKGBUILD's own `package()` installs the binary to /usr/bin/terrustia —
# the real Arch convention for a package managed by pacman (AUR included), where /usr/local is
# reserved for software *not* managed by the distribution's package manager. The generic unit file
# at the top level keeps assuming /usr/local/bin, which is correct for its own documented audience:
# someone who built or downloaded the binary by hand and is not going through a package manager at
# all. One shared unit cannot point at both paths at once, so AUR carries its own copy rather than
# quietly being wrong for whichever audience lost the disagreement.
ExecStart=/usr/bin/terrustia --config /etc/terrustia/terrustia.toml

# The server exits non-zero when it crashes and zero when it is asked to stop, so this restarts
# after a fault and stays down after `systemctl stop`. That distinction only started working when
# the panic path was fixed — before it, a crashed server exited 0 and was never restarted.
Restart=on-failure
RestartSec=5s

# The shutdown save has to finish. SIGTERM is what the server listens for; the default 90 seconds
# is far longer than a save needs even on a large world, and cutting it short loses the difference
# between the last autosave and now.
KillSignal=SIGTERM
TimeoutStopSec=90

# Logs go to the journal. The server writes plain lines to stdout, so `journalctl -u terrustia`
# reads the way the terminal does.
StandardOutput=journal
StandardError=journal

# It needs a network socket and one directory. Everything else is closed off.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/var/lib/terrustia
StateDirectory=terrustia

[Install]
WantedBy=multi-user.target
