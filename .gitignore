# Build output. Regenerated from source; several gigabytes.
/target/
**/*.rs.bk

# Worlds. A .wld is a save file, not source: they are large, binary, and personal, and a stray
# commit of one puts somebody's world into the history permanently.
*.wld
*.wld.bak*
*.twld

# Local configuration, which holds a listen address and a world path for one machine.
/terrustia.toml

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/

# Python bytecode cache from tools/*.py — regenerated, not source.
__pycache__/
*.pyc

# Scratch space for profiling output and captured logs.
/scratch/
*.log
perf.data*
flamegraph.svg

# Decompiled game source, if a generator is ever run with the tree inside this directory.
#
# `.gitattributes` already anticipates `.cs` files arriving; nothing stopped `git add` from
# swallowing the whole decompiled tree along with them. The generators take the tree as a CLI
# argument and never look for it in here, so this is a safety net rather than a workflow.
*.cs
/Terraria*/
/decompiled/
.scratch/
